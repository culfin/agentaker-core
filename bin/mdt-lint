#!/usr/bin/env bash
# Checks that this repository's parts still agree with each other.
# Not a check of your working copies — a check of the repository, so nobody
# lands an example naming a role or subagent we do not ship.
set -uo pipefail

ROOT="${1:-.}"
PROBLEMS=0
problem() { printf '%s\n' "$1"; PROBLEMS=$((PROBLEMS + 1)); }

# Lines under a "## <name>" heading, up to the next heading.
section() {
  awk -v want="$2" '
    /^## / { inside = (tolower(substr($0,4)) == tolower(want)); next }
    inside && NF { print }
  ' "$1"
}

for ex in "$ROOT"/examples/*.AGENTS.md; do
  [ -e "$ex" ] || continue
  name=$(basename "$ex")

  # A heading that lost the space after ## is invisible to section(), which would
  # make every check below it pass vacuously — a lint that finds nothing looks
  # exactly like a lint that passes. Catch the malformed heading rather than
  # trusting that nobody ever writes one.
  bad_heading=$(grep -m1 -E '^##[^[:space:]]' "$ex" || true)
  if [ -n "$bad_heading" ]; then
    problem "$name: heading needs a space after ## — \"$bad_heading\""
  fi

  grep -qE '^trunk:[[:space:]]*[^[:space:]]' "$ex" || problem "$name: no 'trunk:' line"
  grep -qE '^reviewer:[[:space:]]*[^[:space:]]' "$ex" || problem "$name: no 'reviewer:' line — the review round trip needs an account login"
  grep -qiE '^##[[:space:]]+Production boundary' "$ex" || problem "$name: no '## Production boundary' section"
  grep -qiE '^##[[:space:]]+Test commands' "$ex" || problem "$name: no '## Test commands' section"

  for role in $(section "$ex" "Roles"); do
    [ -f "$ROOT/roles/$role.md" ] || problem "$name: names role '$role', which does not exist in roles/"
  done

  for agent in $(section "$ex" "Subagents"); do
    [ -f "$ROOT/agents/$agent.md" ] || problem "$name: names subagent '$agent', which does not exist in agents/"
  done
done

# INSTALL.md instructs an agent to act on someone else's repository. These are
# the sentences that keep it a guide rather than an installer; an edit that
# drops one turns a careful walkthrough into an autonomous one.
if [ -f "$ROOT/INSTALL.md" ]; then
  for required in \
    "Propose, never assume" \
    "Never create credentials" \
    "Never commit without asking" \
    "Never invent a value"
  do
    grep -qF "$required" "$ROOT/INSTALL.md" \
      || problem "INSTALL.md: lost its guard rail — \"$required\""
  done
else
  problem "INSTALL.md is missing"
fi

# Vendor neutrality is the point of the project; a role file naming a tool
# breaks it silently. agents/ is exempt — it is stated to be Claude-specific.
if vendor=$(grep -rliE 'claude|codex|gemini|cursor|copilot|anthropic|openai' "$ROOT"/roles/ 2>/dev/null); then
  for f in $vendor; do problem "$(basename "$f"): names a specific tool — roles must stay vendor-neutral"; done
fi

[ -f "$ROOT/roles/_base.md" ] || problem "roles/_base.md is missing"

# bin/mdt is deliberately few files. The ceiling guards readability, not a
# budget — if a file approaches it, the question is which block has become its
# own concern, the way `init` did.
for script in bin/mdt lib/init.sh lib/manage.sh; do
  if [ -f "$ROOT/$script" ]; then
    lines=$(wc -l < "$ROOT/$script")
    [ "$lines" -le 450 ] || problem "$script is $lines lines — split it or raise the ceiling deliberately"
  fi
done

if [ "$PROBLEMS" -gt 0 ]; then
  printf '\n%d problem(s).\n' "$PROBLEMS"
  exit 1
fi
printf 'mandate: repository is consistent.\n'
