#!/usr/bin/env bash
# atk — give each AI coding session a fixed role and its own git worktree.
#
# Vendor knowledge lives in exactly one function, launch_command() —
# lib/tools.sh now, not this file (see its header) — plus the tools table it
# reads before falling back to its built-in two. Everything else here is
# git, gh and tmux.
set -uo pipefail

# Resolve this script's own location, following symlinks. `ln -s ~/tool/bin/atk
# ~/bin/atk` is the usual way to install a shell tool, and ${BASH_SOURCE[0]} does
# not follow the link — without this, ROLES_DIR lands beside the symlink instead
# of inside the installation and every session fails with "no role file".
# GNU `readlink -f` would be one line, and is missing on the older macOS this
# tool promises to survive.
atk_self=${BASH_SOURCE[0]}
while [ -L "$atk_self" ]; do
  atk_link_dir=$(cd -P "$(dirname "$atk_self")" && pwd)
  atk_self=$(readlink "$atk_self")
  case $atk_self in
    /*) ;;
    *) atk_self="$atk_link_dir/$atk_self" ;;
  esac
done
ATK_HOME=$(cd -P "$(dirname "$atk_self")/.." && pwd)
ROLES_DIR="${ATK_ROLES_DIR:-$ATK_HOME/roles}"
PROJECTS_DIR="${ATK_PROJECTS_DIR:-$HOME/Projekte}"
TOOL="${ATK_TOOL:-}"
DRY_RUN="${ATK_DRY_RUN:-}"
REVIEWER="${ATK_REVIEWER:-}"
CREDENTIAL="${ATK_CREDENTIAL:-}"
LAUNCH_CMD=()

die() { printf 'atk: %s\n' "$1" >&2; exit "${2:-1}"; }

# role_tag() and wrap_launch_command() run on every cmd_start(), the hot
# path — unlike lib/init.sh and lib/manage.sh (see their headers), this is
# sourced unconditionally, not on demand. Split into its own file only to
# keep this one under the 450-line ceiling; see lib/tabs.sh's own header.
# shellcheck source=lib/tabs.sh
. "$ATK_HOME/lib/tabs.sh" || die "cannot load $ATK_HOME/lib/tabs.sh"

# launch_command() runs on the same hot path — see lib/tools.sh's own header
# for why it, too, is sourced unconditionally rather than on demand.
# shellcheck source=lib/tools.sh
. "$ATK_HOME/lib/tools.sh" || die "cannot load $ATK_HOME/lib/tools.sh"

# credential_available() runs on the same hot path, for the same reason —
# see lib/credential.sh's own header for why this one file is also the
# script cmd_start() hands tmux to run directly, later, from inside the
# new pane.
# shellcheck source=lib/credential.sh
. "$ATK_HOME/lib/credential.sh" || die "cannot load $ATK_HOME/lib/credential.sh"

# shellcheck source=lib/throttle.sh
. "$ATK_HOME/lib/throttle.sh" || die "cannot load $ATK_HOME/lib/throttle.sh"

usage() {
  cat <<'EOF'
Usage:
  atk init [repo] [flags]         set a project up, step by step
                                  (atk init --help: flags for a
                                  non-interactive caller, e.g. a GUI —
                                  --trunk, --reviewer, --tests, --boundary,
                                  --yes, --no-*)
  atk <repo> <role> [suffix]      start a session in its own worktree
  atk attach <repo>               re-attach to a repo's tmux session
  atk status [owner] [--json [--since <time>]]
                                  show where work is waiting, across repos
                                  (atk status --help: the JSON board)
  atk list [repo]                 show worktrees, their branch, size and state
  atk drop <repo> <name>          remove a worktree (refuses if it isn't safe)
  atk restart <repo> <name>       hand over, replace the process, resume
  atk restart <repo> <name> --fresh   replace without asking for a handover
  atk restart --all               restart every running session
  atk doctor [tool]               start a tool with a throwaway context and
                                  check whether its role arrived
  atk claims <repo> [--json]      list refs/claims/* — who claimed what, how
                                  long ago, and whether it's past this
                                  project's claim-timeout-days
  atk claim-release <repo> <N>    release and reclaim an orphaned claim
                                  (<N>, 'issue-N' or 'pr-N'); refuses unless
                                  it is actually past the threshold

Roles: developer, reviewer, maintainer

Environment:
  ATK_PROJECTS_DIR      the parent directory your repositories live under, one
                        subdirectory per repo (default: ~/Projekte — a German
                        word, not a typo; set this if yours live elsewhere)
  ATK_ROLES_DIR         where the role files live (default: <install>/roles)
  ATK_TOOL              which coding agent to launch (default: claude)
                        see docs/tools.md for the supported list, and how to
                        add one without editing this file
  ATK_TOOLS_FILE        the tools table (default: $XDG_CONFIG_HOME or
                        ~/.config)/agentaker/tools) — see docs/tools.md
  ATK_DOCTOR_TIMEOUT    seconds `atk doctor` waits for a tool to answer
                        before giving up on it (default: 15)
  ATK_OWNER             default GitHub owner for `atk status`
  ATK_REVIEWER          login of the reviewer account, for `atk status`
  ATK_TAB_COLOUR        iTerm2 tab colour by role (default: on, 0 to disable)
  ATK_HANDOFF_TIMEOUT   seconds to wait for a handover before `restart`
                        aborts (default: 60)
  ATK_YES               answer every `atk init` prompt with its default —
                        the env-var route through it; `atk init --yes` is the
                        flag-driven route and additionally requires --boundary
                        (see `atk init --help`)
  ATK_NO_NETWORK        `atk init` skips the label and environment steps,
                        which otherwise call `gh`
  ATK_DRY_RUN           print what `atk <repo> <role>` would launch instead
                        of launching it (any non-empty value). The worktree,
                        its branch and .agents/ are still created — only the
                        agent process is skipped
  ATK_CREDENTIAL        label of a keychain entry (agentaker-cred-<label>) to
                        put into the started agent's environment — never its
                        argv. A missing or unreadable entry aborts the start;
                        see docs/setup.md, "Named credentials for an agent"
EOF
}

# --- assembling the role ------------------------------------------------------
# Layer 1 (roles/) + layer 3 (.agents/ROLE). Layer 2 is the project's AGENTS.md,
# which the coding agent reads by itself — that is the whole point of the
# standard, and inlining it here would duplicate it into every session.
build_context() {
  local wt=$1 role=$2
  local out="$wt/.agents/context.md"
  {
    cat "$ROLES_DIR/_base.md" &&
    printf '\n\n' &&
    cat "$ROLES_DIR/$role.md"
  } > "$out" || return 1
  [ -s "$out" ] || return 1
}

valid_role_name() {
  case "$1" in
    ""|*[!a-z0-9_-]*|-*) return 1 ;;
    *) return 0 ;;
  esac
}

exclude_agents_dir() {
  local wt=$1 exclude
  exclude=$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null) || return 0
  case "$exclude" in /*) : ;; *) exclude="$wt/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.agents/' "$exclude" 2>/dev/null || printf '.agents/\n' >> "$exclude"
}

session_name() { printf 'atk-%s' "$1"; }

# After tmux accepted the window, never before and never on a dry run — see
# credential_record() in lib/credential.sh. A record that cannot be written
# is said out loud: the session runs, but a later restart would not know
# which credential to put back.
remember_credential() {
  credential_record "$1" "$CREDENTIAL" \
    || printf 'atk: could not record the credential label for %s — a restart would start it without one\n' "$1" >&2
}

# A start from a terminal ends attached to the session, as it always has.
# A start from a program with no terminal (the desktop app) cannot attach —
# `tmux attach` would fail with "not a terminal" and turn a start that
# worked into exit status 1. It says where the session is instead.
attach_if_terminal() {
  if [ -t 0 ] && [ -t 1 ]; then
    tmux attach -t "$1"
  else
    printf 'started in tmux session %s — attach with: atk attach %s\n' "$1" "$2"
  fi
}

cmd_start() {
  local repo=$1 role=$2 suffix=${3:-}
  local repo_dir="$PROJECTS_DIR/$repo"
  local name="$repo-$role${suffix:+-$suffix}"
  local wt="$repo_dir/.worktrees/$name"

  [ -e "$repo_dir/.git" ] || die "$repo_dir is not a git repository"
  valid_role_name "$role" || die "'$role' is not a role name (lowercase letters, digits, - and _)"
  [ -s "$ROLES_DIR/$role.md" ] || die "no role file for '$role' — see $ROLES_DIR"
  if [ "$role" = developer ]; then throttle_start_check "$repo" "$suffix" || exit 1; fi

  if [ ! -d "$wt" ]; then
    git -C "$repo_dir" worktree add "$wt" -b "$name" >/dev/null 2>&1 \
      || git -C "$repo_dir" worktree add "$wt" >/dev/null 2>&1 \
      || die "could not create a worktree at $wt"
  fi

  mkdir -p "$wt/.agents" || die "cannot write to $wt/.agents"
  printf '%s\n' "$role" > "$wt/.agents/ROLE" || die "cannot write $wt/.agents/ROLE"
  exclude_agents_dir "$wt"
  build_context "$wt" "$role" || die "could not assemble the role context from $ROLES_DIR"

  LAUNCH_CMD=()
  TOOL_STATUS=verified
  if ! launch_command "$wt/.agents/context.md"; then
    die "no launch command known for tool '$TOOL' — paste $wt/.agents/context.md as your first message, and consider adding a branch to launch_command() in bin/atk"
  fi

  if [ "${TOOL_STATUS:-verified}" = unverified ]; then
    printf 'atk: the launch path for "%s" has never been run — if this session starts without its role, that is why. See docs/tools.md.\n' "$TOOL" >&2
  fi

  # A named credential (issue #5), unlike the reviewer token below, never
  # falls back to starting without it: a missing or unreadable entry aborts
  # the start outright, before tmux exists in the picture, rather than
  # launching an agent that might quietly authenticate as someone else. See
  # docs/setup.md, "Named credentials for an agent".
  if [ -n "$CREDENTIAL" ]; then
    valid_credential_label "$CREDENTIAL" \
      || die "'$CREDENTIAL' is not a credential label (letters, digits, - and _; see ATK_CREDENTIAL)"
    credential_available "$CREDENTIAL" \
      || die "no readable credential named '$CREDENTIAL' in the keychain — refusing to start without it. See docs/setup.md"
    credential_wrapper_argv "$ATK_HOME" "$CREDENTIAL" "${LAUNCH_CMD[@]}"
  fi

  # The reviewer runs under its own hosting account (issue #10). Wrapped
  # outside a named credential, so that one's export wins; soft, unlike it —
  # see reviewer_token_wrap() in lib/credential.sh.
  if [ "$role" = "reviewer" ]; then reviewer_token_wrap "$ATK_HOME" "${LAUNCH_CMD[@]}"; fi

  local session
  session=$(session_name "$repo")

  # The window name is what a tab actually shows (via #W in the title format
  # below) — short on purpose: the tag alone, or tag-and-suffix when there is
  # one. The worktree/branch name ($name, above) stays untouched; nothing
  # about how worktrees are addressed on disk changes here.
  local tag window_label title
  tag=$(role_tag "$role")
  window_label=$tag
  # Braced, not "$tag·$suffix": in a UTF-8 locale (de_DE.UTF-8 here), bash's
  # parser can read the multibyte "·" right after an unbraced $tag as part of
  # the variable name, and dies with "tag<corrupt-byte> ist nicht gesetzt" —
  # found by running this line under this machine's actual locale, not by
  # inspection.
  [ -n "$suffix" ] && window_label="${tag}·${suffix}"
  title="$repo · $window_label"

  if [ -n "$DRY_RUN" ]; then
    printf 'would launch in tmux session %s, window %s (title: %s): %s\n' \
      "$session" "$window_label" "$title" "${LAUNCH_CMD[*]}"
    return 0
  fi

  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — agentaker uses it so sessions outlive the device looking at them"

  # See wrap_launch_command() for why this has to run from inside the pane
  # itself, and why it exists as a shared function at all.
  wrap_launch_command "$role" "${LAUNCH_CMD[@]}"

  if tmux has-session -t "$session" 2>/dev/null; then
    tmux new-window -t "$session" -c "$wt" -n "$window_label" "${LAUNCH_CMD[@]}" \
      && remember_credential "$wt"
    tmux set-option -t "$session" set-titles on
    tmux set-option -t "$session" set-titles-string '#{s/^atk-//:#S} · #W'
    attach_if_terminal "$session" "$repo"
  else
    # Detached first, not the direct attach new-session offers without -d: the
    # title has to be set session-scoped before anyone looks at the tab, and
    # that needs the session to already exist as a target.
    tmux new-session -d -s "$session" -c "$wt" -n "$window_label" "${LAUNCH_CMD[@]}" \
      && remember_credential "$wt"
    tmux set-option -t "$session" set-titles on
    tmux set-option -t "$session" set-titles-string '#{s/^atk-//:#S} · #W'
    attach_if_terminal "$session" "$repo"
  fi
}

cmd_attach() {
  local repo=${1:-}
  [ -n "$repo" ] || { usage; exit 2; }
  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — agentaker uses it so sessions outlive the device looking at them"
  local session; session=$(session_name "$repo")
  tmux has-session -t "$session" 2>/dev/null \
    || die "no session for '$repo' — start one with: atk $repo developer"
  tmux attach -t "$session"
}

case "${1:-}" in
  "")        usage; exit 2 ;;
  -h|--help) usage; exit 0 ;;
  init)
    shift
    # shellcheck source=lib/init_flags.sh
    . "$ATK_HOME/lib/init_flags.sh" || die "cannot load $ATK_HOME/lib/init_flags.sh"
    # shellcheck source=lib/init.sh
    . "$ATK_HOME/lib/init.sh" || die "cannot load $ATK_HOME/lib/init.sh"
    # shellcheck source=lib/json.sh
    . "$ATK_HOME/lib/json.sh" || die "cannot load $ATK_HOME/lib/json.sh"
    # shellcheck source=lib/init_propose.sh
    . "$ATK_HOME/lib/init_propose.sh" || die "cannot load $ATK_HOME/lib/init_propose.sh"
    cmd_init "$@"
    ;;
  status)
    shift
    # shellcheck source=lib/json.sh
    . "$ATK_HOME/lib/json.sh" || die "cannot load $ATK_HOME/lib/json.sh"
    # shellcheck source=lib/status.sh
    . "$ATK_HOME/lib/status.sh" || die "cannot load $ATK_HOME/lib/status.sh"
    # shellcheck source=lib/status_json.sh
    . "$ATK_HOME/lib/status_json.sh" || die "cannot load $ATK_HOME/lib/status_json.sh"
    status_dispatch "$@"
    ;;
  attach)    shift; cmd_attach "$@" ;;
  list)
    shift
    # shellcheck source=lib/manage.sh
    . "$ATK_HOME/lib/manage.sh" || die "cannot load $ATK_HOME/lib/manage.sh"
    cmd_list "$@"
    ;;
  drop)
    shift
    # shellcheck source=lib/manage.sh
    . "$ATK_HOME/lib/manage.sh" || die "cannot load $ATK_HOME/lib/manage.sh"
    cmd_drop "$@"
    ;;
  restart)
    shift
    # shellcheck source=lib/manage.sh
    . "$ATK_HOME/lib/manage.sh" || die "cannot load $ATK_HOME/lib/manage.sh"
    # shellcheck source=lib/state.sh
    . "$ATK_HOME/lib/state.sh" || die "cannot load $ATK_HOME/lib/state.sh"
    cmd_restart "$@"
    ;;
  doctor)
    shift
    # shellcheck source=lib/doctor.sh
    . "$ATK_HOME/lib/doctor.sh" || die "cannot load $ATK_HOME/lib/doctor.sh"
    cmd_doctor "$@"
    ;;
  claims)
    shift
    # shellcheck source=lib/json.sh
    . "$ATK_HOME/lib/json.sh" || die "cannot load $ATK_HOME/lib/json.sh"
    # shellcheck source=lib/claims.sh
    . "$ATK_HOME/lib/claims.sh" || die "cannot load $ATK_HOME/lib/claims.sh"
    cmd_claims "$@"
    ;;
  claim-release)
    shift
    # shellcheck source=lib/json.sh
    . "$ATK_HOME/lib/json.sh" || die "cannot load $ATK_HOME/lib/json.sh"
    # shellcheck source=lib/claims.sh
    . "$ATK_HOME/lib/claims.sh" || die "cannot load $ATK_HOME/lib/claims.sh"
    cmd_claim_release "$@"
    ;;
  *)         [ $# -ge 2 ] || { usage; exit 2; }; cmd_start "$@" ;;
esac
