#!/usr/bin/env bash
# wtc — give each AI coding session a fixed role and its own git worktree.
#
# Vendor knowledge lives in exactly one place in this file: launch_command().
# Everything else is git, gh and tmux.
set -uo pipefail

# Resolve this script's own location, following symlinks. `ln -s ~/tool/bin/wtc
# ~/bin/wtc` is the usual way to install a shell tool, and ${BASH_SOURCE[0]} does
# not follow the link — without this, ROLES_DIR lands beside the symlink instead
# of inside the installation and every session fails with "no role file".
# GNU `readlink -f` would be one line, and is missing on the older macOS this
# tool promises to survive.
wtc_self=${BASH_SOURCE[0]}
while [ -L "$wtc_self" ]; do
  wtc_link_dir=$(cd -P "$(dirname "$wtc_self")" && pwd)
  wtc_self=$(readlink "$wtc_self")
  case $wtc_self in
    /*) ;;
    *) wtc_self="$wtc_link_dir/$wtc_self" ;;
  esac
done
WTC_HOME=$(cd -P "$(dirname "$wtc_self")/.." && pwd)
ROLES_DIR="${WTC_ROLES_DIR:-$WTC_HOME/roles}"
PROJECTS_DIR="${WTC_PROJECTS_DIR:-$HOME/Projekte}"
TOOL="${WTC_TOOL:-}"
DRY_RUN="${WTC_DRY_RUN:-}"
REVIEWER="${WTC_REVIEWER:-}"
LAUNCH_CMD=()
STATUS_FAILED=0

die() { printf 'wtc: %s\n' "$1" >&2; exit "${2:-1}"; }

usage() {
  cat <<'EOF'
Usage:
  wtc init [repo]              set a project up, step by step
  wtc <repo> <role> [suffix]   start a session in its own worktree
  wtc attach <repo>            re-attach to a repo's tmux session
  wtc status [owner]           show where work is waiting, across repos

Roles: developer, reviewer, integrator

Environment:
  WTC_PROJECTS_DIR   where your repositories live (default: ~/Projekte)
  WTC_ROLES_DIR      where the role files live (default: <install>/roles)
  WTC_TOOL           which coding agent to launch (default: claude)
                     see launch_command() in bin/wtc for the supported list
  WTC_OWNER          default GitHub owner for `wtc status`
  WTC_REVIEWER       login of the reviewer account, for `wtc status`
EOF
}

# --- the one vendor-aware function -------------------------------------------
# Sets the global array LAUNCH_CMD to the argv that starts $TOOL with $1 (the
# assembled role file) as its system prompt. Returns 1 when the tool is unknown.
#
# A global rather than a printed list, for two reasons: `mapfile` does not exist
# in bash 3.2, which is still /bin/bash on macOS, and a multi-line prompt would
# shred any line-based protocol anyway.
#
# Adding a tool means adding one branch here and one row in docs/tools.md —
# nothing else in this repository changes.
launch_command() {
  local ctx=$1 tool=${TOOL:-claude}
  case "$tool" in
    claude)
      # Verified 2026-09-20 against Claude Code.
      LAUNCH_CMD=(claude --append-system-prompt-file "$ctx")
      ;;
    codex)
      # UNVERIFIED — codex was not installed when this was written.
      # If this is wrong, fix it here and say so in docs/tools.md.
      LAUNCH_CMD=(codex --prompt-file "$ctx")
      ;;
    *)
      LAUNCH_CMD=()
      return 1
      ;;
  esac
}

# --- assembling the role ------------------------------------------------------
# Layer 1 (roles/) + layer 3 (.agents/ROLE). Layer 2 is the project's AGENTS.md,
# which the coding agent reads by itself — that is the whole point of the
# standard, and inlining it here would duplicate it into every session.
build_context() {
  local wt=$1 role=$2
  local out="$wt/.agents/context.md"
  {
    cat "$ROLES_DIR/_base.md" &&
    printf '\n\n' &&
    cat "$ROLES_DIR/$role.md"
  } > "$out" || return 1
  [ -s "$out" ] || return 1
}

valid_role_name() {
  case "$1" in
    ""|*[!a-z0-9_-]*|-*) return 1 ;;
    *) return 0 ;;
  esac
}

exclude_agents_dir() {
  local wt=$1 exclude
  exclude=$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null) || return 0
  case "$exclude" in /*) : ;; *) exclude="$wt/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.agents/' "$exclude" 2>/dev/null || printf '.agents/\n' >> "$exclude"
}

session_name() { printf 'wtc-%s' "$1"; }

read_reviewer_token() {
  if command -v security >/dev/null 2>&1; then
    security find-generic-password -s worktree-crew-reviewer -w 2>/dev/null && return 0
  fi
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service worktree-crew-reviewer 2>/dev/null && return 0
  fi
  return 1
}

cmd_start() {
  local repo=$1 role=$2 suffix=${3:-}
  local repo_dir="$PROJECTS_DIR/$repo"
  local name="$repo-$role${suffix:+-$suffix}"
  local wt="$repo_dir/.worktrees/$name"

  [ -e "$repo_dir/.git" ] || die "$repo_dir is not a git repository"
  valid_role_name "$role" || die "'$role' is not a role name (lowercase letters, digits, - and _)"
  [ -s "$ROLES_DIR/$role.md" ] || die "no role file for '$role' — see $ROLES_DIR"

  if [ ! -d "$wt" ]; then
    git -C "$repo_dir" worktree add "$wt" -b "$name" >/dev/null 2>&1 \
      || git -C "$repo_dir" worktree add "$wt" >/dev/null 2>&1 \
      || die "could not create a worktree at $wt"
  fi

  mkdir -p "$wt/.agents" || die "cannot write to $wt/.agents"
  printf '%s\n' "$role" > "$wt/.agents/ROLE" || die "cannot write $wt/.agents/ROLE"
  exclude_agents_dir "$wt"
  build_context "$wt" "$role" || die "could not assemble the role context from $ROLES_DIR"

  LAUNCH_CMD=()
  if ! launch_command "$wt/.agents/context.md"; then
    die "no launch command known for tool '$TOOL' — paste $wt/.agents/context.md as your first message, and consider adding a branch to launch_command() in bin/wtc"
  fi

  # The reviewer runs under its own hosting account. Its token lives in the OS
  # keychain, never in a settings file, and is set for this session only.
  local token=""
  if [ "$role" = "reviewer" ]; then
    if ! token=$(read_reviewer_token); then
      token=""
      printf 'wtc: no reviewer token found — approvals will fail. See docs/setup.md\n' >&2
    fi
  fi

  local session
  session=$(session_name "$repo")

  if [ -n "$DRY_RUN" ]; then
    printf 'would launch in tmux session %s, window %s: %s\n' "$session" "$name" "${LAUNCH_CMD[*]}"
    return 0
  fi

  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — worktree-crew uses it so sessions outlive the device looking at them"

  # Two explicit branches rather than expanding a possibly-empty array:
  # "${arr[@]}" on an empty array is an unbound-variable error under `set -u`
  # in bash 3.2.
  if tmux has-session -t "$session" 2>/dev/null; then
    if [ -n "$token" ]; then
      tmux new-window -t "$session" -c "$wt" -n "$name" -e "GH_TOKEN=$token" "${LAUNCH_CMD[@]}"
    else
      tmux new-window -t "$session" -c "$wt" -n "$name" "${LAUNCH_CMD[@]}"
    fi
    tmux attach -t "$session"
  else
    if [ -n "$token" ]; then
      tmux new-session -s "$session" -c "$wt" -n "$name" -e "GH_TOKEN=$token" "${LAUNCH_CMD[@]}"
    else
      tmux new-session -s "$session" -c "$wt" -n "$name" "${LAUNCH_CMD[@]}"
    fi
  fi
}

# Ask gh one question and render the answer. Distinguishes three outcomes that
# must never look alike: rows, no rows, and "I could not ask".
# Sets STATUS_FAILED=1 on the third, so cmd_status() can exit non-zero.
status_query() {
  local heading=$1
  shift
  local out rc
  out=$(gh "$@" 2>&1)
  rc=$?
  printf '%s:\n' "$heading"
  if [ "$rc" -ne 0 ]; then
    printf '  could not ask: %s\n' "$(printf '%s' "$out" | head -1)"
    STATUS_FAILED=1
    return 0
  fi
  if [ -z "$out" ]; then
    printf '  (none)\n'
  else
    printf '%s\n' "$out"
  fi
}

cmd_status() {
  local owner=${1:-${WTC_OWNER:-}}
  [ -n "$owner" ] || die "give an owner: wtc status <owner>  (or set WTC_OWNER)"

  STATUS_FAILED=0

  status_query "ready to pick up" \
    search issues --owner "$owner" --state open --label ready \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  if [ -n "$REVIEWER" ]; then
    status_query "waiting for review" \
      search prs --owner "$owner" --state open --draft=false --review-requested "$REVIEWER" \
      --json repository,number,title,author \
      --jq '.[] | select(.author.login | test("dependabot") | not) | "  \(.repository.name)#\(.number)  \(.title)"'
  else
    status_query "waiting for review" \
      search prs --owner "$owner" --state open --draft=false --review none \
      --json repository,number,title,author \
      --jq '.[] | select(.author.login | test("dependabot") | not) | "  \(.repository.name)#\(.number)  \(.title)"'
    printf '  (approximate — set WTC_REVIEWER to your reviewer login for the exact queue)\n'
  fi

  status_query "approved, waiting for merge" \
    search prs --owner "$owner" --state open --review approved \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  status_query "waiting on you" \
    search issues --owner "$owner" --state open --label needs-decision \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  if [ "$STATUS_FAILED" -ne 0 ]; then
    printf '\nSome questions could not be asked — this board is incomplete.\n' >&2
    return 1
  fi
  return 0
}

cmd_attach() {
  local repo=${1:-}
  [ -n "$repo" ] || { usage; exit 2; }
  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — worktree-crew uses it so sessions outlive the device looking at them"
  local session; session=$(session_name "$repo")
  tmux has-session -t "$session" 2>/dev/null \
    || die "no session for '$repo' — start one with: wtc $repo developer"
  tmux attach -t "$session"
}

# --- guided setup -------------------------------------------------------------
# `wtc init` shows every step instead of hiding it: each action is proposed and
# confirmed separately, so someone who watched it run can redo it by hand.

ask() {
  # Prompt unless WTC_YES is set; echo the (possibly default) answer.
  local prompt=$1 default=${2:-y} reply
  if [ -n "${WTC_YES:-}" ]; then printf '%s' "$default"; return 0; fi
  printf '  %s [%s] ' "$prompt" "$default" >&2
  read -r reply || reply=""
  printf '%s' "${reply:-$default}"
}

detect_stack() {
  local dir=$1 found=""
  [ -f "$dir/Cargo.toml" ]        && found="$found Rust"
  [ -f "$dir/package.json" ]      && found="$found Node"
  [ -f "$dir/pyproject.toml" ]    && found="$found Python"
  [ -f "$dir/go.mod" ]            && found="$found Go"
  [ -d "$dir/src-tauri" ]         && found="$found Tauri"
  [ -f "$dir/svelte.config.js" ]  && found="$found Svelte"
  if [ -f "$dir/next.config.ts" ] || [ -f "$dir/next.config.js" ]; then
    found="$found Next.js"
  fi
  [ -f "$dir/astro.config.mjs" ]  && found="$found Astro"
  printf '%s' "${found# }"
}

suggest_tests() {
  case "$1" in
    *Rust*Tauri*|*Tauri*)  printf 'cargo test --workspace\npnpm exec svelte-check' ;;
    *Rust*)                printf 'cargo test --workspace' ;;
    *Next.js*|*Node*)      printf 'pnpm lint\npnpm test\npnpm build' ;;
    *Python*)              printf 'pytest -q\nruff check .' ;;
    *Go*)                  printf 'go test ./...' ;;
    *)                     printf '# no test command detected — fill this in' ;;
  esac
}

cmd_init() {
  local repo=${1:-}
  [ -n "$repo" ] || { usage; exit 2; }
  local dir="$PROJECTS_DIR/$repo"
  [ -e "$dir/.git" ] || die "$dir is not a git repository"

  local ver
  printf 'Checking what we need:\n'
  for bin in git gh tmux; do
    if command -v "$bin" >/dev/null 2>&1; then
      case "$bin" in
        tmux) ver=$(tmux -V 2>&1) ;;
        *)    ver=$("$bin" --version 2>&1 | head -1) ;;
      esac
      printf '  ok   %s (%s)\n' "$bin" "$ver"
    else
      printf '  MISSING %s — install it first\n' "$bin"
    fi
  done

  local trunk; trunk=$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || echo main)
  local stack; stack=$(detect_stack "$dir")
  printf '\nProject: %s\n  trunk:  %s\n  stack:  %s\n' "$dir" "$trunk" "${stack:-unknown}"

  # --- AGENTS.md ------------------------------------------------------------
  if [ -f "$dir/AGENTS.md" ]; then
    printf '\n  %s already has an AGENTS.md — leaving it alone.\n' "$repo"
    printf '  Make sure it names: trunk, reviewer, test commands, production boundary.\n'
  else
    printf '\nProposed AGENTS.md:\n\n'
    local draft; draft=$(cat <<EOF
# Agents in this project

trunk: $trunk
reviewer:            # GitHub login of the account that reviews here — see docs/setup.md

## Test commands

$(suggest_tests "$stack")

## Production boundary

The one line an agent must never cross on its own. Examples:

    git push origin main:production
    npm publish

Replace this with yours. Until you do, agents will refuse to release.

## Roles

developer reviewer integrator
EOF
)
    printf '%s\n\n' "$draft"
    if [ "$(ask 'Write this file? (y/n)' y)" = "y" ]; then
      printf '%s\n' "$draft" > "$dir/AGENTS.md"
      printf '  written: %s/AGENTS.md — edit the production boundary before you rely on it.\n' "$dir"
    fi
  fi

  # --- labels ---------------------------------------------------------------
  if [ -z "${WTC_NO_NETWORK:-}" ] && [ "$(ask 'Create the two labels on the remote? (y/n)' y)" = "y" ]; then
    (
      cd "$dir" || exit 1
      if gh label create ready --description "Ready for an agent to pick up" --color 0E8A16 2>/dev/null; then
        printf '  label created: ready\n'
      else
        printf '  label ready: already there, or no access\n'
      fi
      if gh label create needs-decision --description "Waiting on a human decision" --color D93F0B 2>/dev/null; then
        printf '  label created: needs-decision\n'
      else
        printf '  label needs-decision: already there, or no access\n'
      fi
    )
  fi

  # --- production boundary -------------------------------------------------
  # Every other boundary here is a sentence in a Markdown file; this one is a
  # lock, since a release reaches real users and cannot be undone like a merge.
  if [ -z "${WTC_NO_NETWORK:-}" ]; then
    printf '\nThe production boundary needs a lock: a protected environment makes the\n'
    printf 'job wait for you in the browser, whoever triggered it.\n'
    if [ "$(ask 'Create a protected "production" environment? (y/n)' y)" = "y" ]; then
      (
        cd "$dir" || exit 1
        uid=$(gh api user --jq .id 2>/dev/null) || exit 1
        slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 1
        if printf '{"reviewers":[{"type":"User","id":%s}]}' "$uid" \
             | gh api -X PUT "repos/$slug/environments/production" --input - >/dev/null 2>&1; then
          printf '  environment created: production (you are the required reviewer)\n'
        else
          printf '  could not create the environment — create it by hand, see docs/setup.md\n'
        fi
      )
      printf '\n  One line is still yours to add, on the job that crosses the boundary:\n'
      printf '      jobs:\n        release:\n          environment: production\n'
      printf '  Without it the environment exists and protects nothing.\n'
    fi
  fi

  # --- worktrees ------------------------------------------------------------
  if [ "$(ask 'Create worktrees for the three roles? (y/n)' y)" = "y" ]; then
    for role in developer reviewer integrator; do
      if ( DRY_RUN=1; cmd_start "$repo" "$role" ) >/dev/null 2>&1; then
        printf '  worktree: %s-%s\n' "$repo" "$role"
      else
        printf '  could not create the %s worktree — run `wtc %s %s` to see why\n' "$role" "$repo" "$role"
      fi
    done
  fi

  local first_step
  if [ -f "$dir/AGENTS.md" ]; then
    first_step="Edit $dir/AGENTS.md — above all the production boundary."
  else
    first_step="Create $dir/AGENTS.md — run this again, or copy one from examples/."
  fi

  cat <<EOF

Done. Next:
  1. $first_step
  2. Put the reviewer account's login in AGENTS.md — without it the reviewer
     cannot be asked for a review. See docs/setup.md.
  3. Give the reviewer its own account: docs/setup.md
  4. Put 'ready' on an issue:   gh issue edit <N> --add-label ready
  5. Start working:             wtc $repo developer
EOF
}

case "${1:-}" in
  "")        usage; exit 2 ;;
  -h|--help) usage; exit 0 ;;
  init)      shift; cmd_init "$@" ;;
  status)    shift; cmd_status "$@" ;;
  attach)    shift; cmd_attach "$@" ;;
  *)         [ $# -ge 2 ] || { usage; exit 2; }; cmd_start "$@" ;;
esac
