#!/usr/bin/env bash
# wtc — give each AI coding session a fixed role and its own git worktree.
#
# Vendor knowledge lives in exactly one place in this file: launch_command().
# Everything else is git, gh and tmux.
set -uo pipefail

# Resolve this script's own location, following symlinks. `ln -s ~/tool/bin/wtc
# ~/bin/wtc` is the usual way to install a shell tool, and ${BASH_SOURCE[0]} does
# not follow the link — without this, ROLES_DIR lands beside the symlink instead
# of inside the installation and every session fails with "no role file".
# GNU `readlink -f` would be one line, and is missing on the older macOS this
# tool promises to survive.
wtc_self=${BASH_SOURCE[0]}
while [ -L "$wtc_self" ]; do
  wtc_link_dir=$(cd -P "$(dirname "$wtc_self")" && pwd)
  wtc_self=$(readlink "$wtc_self")
  case $wtc_self in
    /*) ;;
    *) wtc_self="$wtc_link_dir/$wtc_self" ;;
  esac
done
WTC_HOME=$(cd -P "$(dirname "$wtc_self")/.." && pwd)
ROLES_DIR="${WTC_ROLES_DIR:-$WTC_HOME/roles}"
PROJECTS_DIR="${WTC_PROJECTS_DIR:-$HOME/Projekte}"
TOOL="${WTC_TOOL:-}"
DRY_RUN="${WTC_DRY_RUN:-}"
REVIEWER="${WTC_REVIEWER:-}"
LAUNCH_CMD=()
STATUS_FAILED=0

die() { printf 'wtc: %s\n' "$1" >&2; exit "${2:-1}"; }

usage() {
  cat <<'EOF'
Usage:
  wtc init [repo]              set a project up, step by step
  wtc <repo> <role> [suffix]   start a session in its own worktree
  wtc attach <repo>            re-attach to a repo's tmux session
  wtc status [owner]           show where work is waiting, across repos
  wtc list [repo]               show worktrees, their branch, size and state
  wtc drop <repo> <name>        remove a worktree (refuses if it isn't safe)

Roles: developer, reviewer, maintainer

Environment:
  WTC_PROJECTS_DIR   where your repositories live (default: ~/Projekte)
  WTC_ROLES_DIR      where the role files live (default: <install>/roles)
  WTC_TOOL           which coding agent to launch (default: claude)
                     see launch_command() in bin/wtc for the supported list
  WTC_OWNER          default GitHub owner for `wtc status`
  WTC_REVIEWER       login of the reviewer account, for `wtc status`
  WTC_TAB_COLOUR     iTerm2 tab colour by role (default: on, 0 to disable)
EOF
}

# --- legible tabs --------------------------------------------------------
# A terminal tab shows one line and the user reads it at a glance: project,
# then who. Everything else is noise — the session name already carries
# "wtc", so repeating it costs characters and says nothing.
#
# developer -> DEV, reviewer -> REV, maintainer -> MNT, none -> ---, anything
# else -> its first three characters, uppercased. tr, not ${var^^}: bash 3.2
# (still /bin/bash on macOS) doesn't have the latter.
role_tag() {
  case "$1" in
    developer)  printf 'DEV' ;;
    reviewer)   printf 'REV' ;;
    maintainer) printf 'MNT' ;;
    # `printf --` and not bare `printf '---'`: bash's own printf builtin reads
    # a format string starting with `-` as an option and refuses it — found
    # by the test in tests/test_start.sh that runs this exact case, not by
    # reading the code.
    none)       printf -- '---' ;;
    *)          printf '%s' "$(printf '%.3s' "$1" | tr '[:lower:]' '[:upper:]')" ;;
  esac
}

# iTerm2's own tab-colour codes are proprietary, and only iTerm2 understands
# them — a stray escape sequence in a terminal that doesn't is worse than no
# colour, it prints garbage. Every wtc-launched pane runs inside tmux, so
# TERM_PROGRAM inside the pane is always "tmux" (tmux sets it itself); that
# check has to happen here, in wtc's own process, before tmux exists in the
# picture. iTerm2's tmux integration sets LC_TERMINAL for exactly this reason
# — it's the one signal that survives being wrapped in tmux.
iterm2_detected() {
  [ "${TERM_PROGRAM:-}" = "iTerm2" ] || [ "${LC_TERMINAL:-}" = "iTerm2" ]
}

tab_colour_rgb() {
  case "$1" in
    developer)  printf '0;122;255' ;;
    reviewer)   printf '255;204;0' ;;
    maintainer) printf '52;199;89' ;;
    *)          return 1 ;;
  esac
}

# One DCS-wrapped OSC 6 component (iTerm2's per-channel tab colour code).
# tmux's passthrough convention requires doubling any ESC embedded in the
# wrapped payload; each component command here carries exactly one (its own
# leading ESC), so the wrap is a single doubling. Three calls — red, green,
# blue — build the full colour; see tab_colour_sequence().
osc6_component() {
  printf '\033Ptmux;\033]6;1;bg;%s;brightness;%s\a\033\\' "$1" "$2"
}

# The full escape sequence for $1's tab colour, or nothing (rc 1) if the role
# has none. Emitting this is the caller's job — see cmd_start(), which runs
# it from inside the new pane itself, not from here, so there is no race
# against the allow-passthrough option that has to be on first.
tab_colour_sequence() {
  local rgb r g b
  rgb=$(tab_colour_rgb "$1") || return 1
  IFS=';' read -r r g b <<EOF
$rgb
EOF
  printf '%s%s%s' "$(osc6_component red "$r")" "$(osc6_component green "$g")" "$(osc6_component blue "$b")"
}

# --- the one vendor-aware function -------------------------------------------
# Sets the global array LAUNCH_CMD to the argv that starts $TOOL with $1 (the
# assembled role file) as its system prompt. Returns 1 when the tool is unknown.
#
# A global rather than a printed list, for two reasons: `mapfile` does not exist
# in bash 3.2, which is still /bin/bash on macOS, and a multi-line prompt would
# shred any line-based protocol anyway.
#
# Adding a tool means adding one branch here and one row in docs/tools.md —
# nothing else in this repository changes.
launch_command() {
  local ctx=$1 tool=${TOOL:-claude}
  case "$tool" in
    claude)
      # Verified 2026-09-20 against Claude Code.
      LAUNCH_CMD=(claude --append-system-prompt-file "$ctx")
      ;;
    codex)
      # UNVERIFIED — codex was not installed when this was written.
      # If this is wrong, fix it here and say so in docs/tools.md.
      LAUNCH_CMD=(codex --prompt-file "$ctx")
      ;;
    *)
      LAUNCH_CMD=()
      return 1
      ;;
  esac
}

# --- assembling the role ------------------------------------------------------
# Layer 1 (roles/) + layer 3 (.agents/ROLE). Layer 2 is the project's AGENTS.md,
# which the coding agent reads by itself — that is the whole point of the
# standard, and inlining it here would duplicate it into every session.
build_context() {
  local wt=$1 role=$2
  local out="$wt/.agents/context.md"
  {
    cat "$ROLES_DIR/_base.md" &&
    printf '\n\n' &&
    cat "$ROLES_DIR/$role.md"
  } > "$out" || return 1
  [ -s "$out" ] || return 1
}

valid_role_name() {
  case "$1" in
    ""|*[!a-z0-9_-]*|-*) return 1 ;;
    *) return 0 ;;
  esac
}

exclude_agents_dir() {
  local wt=$1 exclude
  exclude=$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null) || return 0
  case "$exclude" in /*) : ;; *) exclude="$wt/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.agents/' "$exclude" 2>/dev/null || printf '.agents/\n' >> "$exclude"
}

session_name() { printf 'wtc-%s' "$1"; }

read_reviewer_token() {
  if command -v security >/dev/null 2>&1; then
    security find-generic-password -s worktree-crew-reviewer -w 2>/dev/null && return 0
  fi
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service worktree-crew-reviewer 2>/dev/null && return 0
  fi
  return 1
}

cmd_start() {
  local repo=$1 role=$2 suffix=${3:-}
  local repo_dir="$PROJECTS_DIR/$repo"
  local name="$repo-$role${suffix:+-$suffix}"
  local wt="$repo_dir/.worktrees/$name"

  [ -e "$repo_dir/.git" ] || die "$repo_dir is not a git repository"
  valid_role_name "$role" || die "'$role' is not a role name (lowercase letters, digits, - and _)"
  [ -s "$ROLES_DIR/$role.md" ] || die "no role file for '$role' — see $ROLES_DIR"

  if [ ! -d "$wt" ]; then
    git -C "$repo_dir" worktree add "$wt" -b "$name" >/dev/null 2>&1 \
      || git -C "$repo_dir" worktree add "$wt" >/dev/null 2>&1 \
      || die "could not create a worktree at $wt"
  fi

  mkdir -p "$wt/.agents" || die "cannot write to $wt/.agents"
  printf '%s\n' "$role" > "$wt/.agents/ROLE" || die "cannot write $wt/.agents/ROLE"
  exclude_agents_dir "$wt"
  build_context "$wt" "$role" || die "could not assemble the role context from $ROLES_DIR"

  LAUNCH_CMD=()
  if ! launch_command "$wt/.agents/context.md"; then
    die "no launch command known for tool '$TOOL' — paste $wt/.agents/context.md as your first message, and consider adding a branch to launch_command() in bin/wtc"
  fi

  # The reviewer runs under its own hosting account. Its token lives in the OS
  # keychain, never in a settings file, and is set for this session only.
  local token=""
  if [ "$role" = "reviewer" ]; then
    if ! token=$(read_reviewer_token); then
      token=""
      printf 'wtc: no reviewer token found — approvals will fail. See docs/setup.md\n' >&2
    fi
  fi

  local session
  session=$(session_name "$repo")

  # The window name is what a tab actually shows (via #W in the title format
  # below) — short on purpose: the tag alone, or tag-and-suffix when there is
  # one. The worktree/branch name ($name, above) stays untouched; nothing
  # about how worktrees are addressed on disk changes here.
  local tag window_label title
  tag=$(role_tag "$role")
  window_label=$tag
  # Braced, not "$tag·$suffix": in a UTF-8 locale (de_DE.UTF-8 here), bash's
  # parser can read the multibyte "·" right after an unbraced $tag as part of
  # the variable name, and dies with "tag<corrupt-byte> ist nicht gesetzt" —
  # found by running this line under this machine's actual locale, not by
  # inspection.
  [ -n "$suffix" ] && window_label="${tag}·${suffix}"
  title="$repo · $window_label"

  if [ -n "$DRY_RUN" ]; then
    printf 'would launch in tmux session %s, window %s (title: %s): %s\n' \
      "$session" "$window_label" "$title" "${LAUNCH_CMD[*]}"
    return 0
  fi

  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — worktree-crew uses it so sessions outlive the device looking at them"

  # The window name survives only if two other actors are stopped from
  # touching it — measured, not assumed: a coding agent that sets its own
  # process/window title, on a stock tmux (automatic-rename defaults on),
  # gets its own name back within moments of starting, silently, with no
  # error anywhere. `allow-rename` (the program renaming itself via escape
  # sequence) and `automatic-rename` (tmux's own rename-to-current-command)
  # are two separate mechanisms; measured against a real coding-agent
  # session, allow-rename was already off and the rename still happened —
  # automatic-rename was the one responsible. Both are turned off anyway,
  # since either could be the culprit on a different tmux config.
  #
  # This — like the colour below — has to run from inside the pane itself,
  # window-scoped via its own $TMUX_PANE, as its first act: a `tmux
  # set-window-option` issued from wtc's own process, after creation, would
  # race the pane's first automatic-rename evaluation. Measured with a
  # stand-in command across 3 seconds of wall time: zero flicker once this
  # runs before anything else does.
  #
  # Colour, right after, if the role has one, WTC_TAB_COLOUR hasn't disabled
  # it, and this is iTerm2. It has to come from inside the pane to reach the
  # terminal at all, and turning allow-passthrough on from inside — same
  # $TMUX_PANE, window-scoped, never global — avoids the same race: a pane
  # that starts emitting before the option is on.
  local colour_seq=""
  if [ "${WTC_TAB_COLOUR:-1}" != "0" ] && iterm2_detected; then
    colour_seq=$(tab_colour_sequence "$role") || colour_seq=""
  fi

  LAUNCH_CMD=(sh -c '
    tmux set-window-option -t "$TMUX_PANE" automatic-rename off 2>/dev/null
    tmux set-window-option -t "$TMUX_PANE" allow-rename off 2>/dev/null
    tmux set-option -t "$TMUX_PANE" allow-passthrough on 2>/dev/null
    printf "%s" "$1"
    shift
    exec "$@"
  ' wtc "$colour_seq" "${LAUNCH_CMD[@]}")

  # Two explicit branches rather than expanding a possibly-empty array:
  # "${arr[@]}" on an empty array is an unbound-variable error under `set -u`
  # in bash 3.2.
  if tmux has-session -t "$session" 2>/dev/null; then
    if [ -n "$token" ]; then
      tmux new-window -t "$session" -c "$wt" -n "$window_label" -e "GH_TOKEN=$token" "${LAUNCH_CMD[@]}"
    else
      tmux new-window -t "$session" -c "$wt" -n "$window_label" "${LAUNCH_CMD[@]}"
    fi
    tmux set-option -t "$session" set-titles on
    tmux set-option -t "$session" set-titles-string '#{s/^wtc-//:#S} · #W'
    tmux attach -t "$session"
  else
    # Detached first, not the direct attach new-session offers without -d: the
    # title has to be set session-scoped before anyone looks at the tab, and
    # that needs the session to already exist as a target.
    if [ -n "$token" ]; then
      tmux new-session -d -s "$session" -c "$wt" -n "$window_label" -e "GH_TOKEN=$token" "${LAUNCH_CMD[@]}"
    else
      tmux new-session -d -s "$session" -c "$wt" -n "$window_label" "${LAUNCH_CMD[@]}"
    fi
    tmux set-option -t "$session" set-titles on
    tmux set-option -t "$session" set-titles-string '#{s/^wtc-//:#S} · #W'
    tmux attach -t "$session"
  fi
}

# Ask gh one question and render the answer. Distinguishes three outcomes that
# must never look alike: rows, no rows, and "I could not ask".
# Sets STATUS_FAILED=1 on the third, so cmd_status() can exit non-zero.
status_query() {
  local heading=$1
  shift
  local out rc
  out=$(gh "$@" 2>&1)
  rc=$?
  printf '%s:\n' "$heading"
  if [ "$rc" -ne 0 ]; then
    printf '  could not ask: %s\n' "$(printf '%s' "$out" | head -1)"
    STATUS_FAILED=1
    return 0
  fi
  if [ -z "$out" ]; then
    printf '  (none)\n'
  else
    printf '%s\n' "$out"
  fi
}

cmd_status() {
  local owner=${1:-${WTC_OWNER:-}}
  [ -n "$owner" ] || die "give an owner: wtc status <owner>  (or set WTC_OWNER)"

  STATUS_FAILED=0

  status_query "ready to pick up" \
    search issues --owner "$owner" --state open --label ready \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  if [ -n "$REVIEWER" ]; then
    status_query "waiting for review" \
      search prs --owner "$owner" --state open --draft=false --review-requested "$REVIEWER" \
      --json repository,number,title,author \
      --jq '.[] | select(.author.login | test("dependabot") | not) | "  \(.repository.name)#\(.number)  \(.title)"'
  else
    status_query "waiting for review" \
      search prs --owner "$owner" --state open --draft=false --review none \
      --json repository,number,title,author \
      --jq '.[] | select(.author.login | test("dependabot") | not) | "  \(.repository.name)#\(.number)  \(.title)"'
    printf '  (approximate — set WTC_REVIEWER to your reviewer login for the exact queue)\n'
  fi

  status_query "approved, waiting for merge" \
    search prs --owner "$owner" --state open --review approved \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  status_query "waiting on you" \
    search issues --owner "$owner" --state open --label needs-decision \
    --json repository,number,title \
    --jq '.[] | "  \(.repository.name)#\(.number)  \(.title)"'

  if [ "$STATUS_FAILED" -ne 0 ]; then
    printf '\nSome questions could not be asked — this board is incomplete.\n' >&2
    return 1
  fi
  return 0
}

cmd_attach() {
  local repo=${1:-}
  [ -n "$repo" ] || { usage; exit 2; }
  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed — worktree-crew uses it so sessions outlive the device looking at them"
  local session; session=$(session_name "$repo")
  tmux has-session -t "$session" 2>/dev/null \
    || die "no session for '$repo' — start one with: wtc $repo developer"
  tmux attach -t "$session"
}

case "${1:-}" in
  "")        usage; exit 2 ;;
  -h|--help) usage; exit 0 ;;
  init)
    shift
    # shellcheck source=lib/init.sh
    . "$WTC_HOME/lib/init.sh" || die "cannot load $WTC_HOME/lib/init.sh"
    cmd_init "$@"
    ;;
  status)    shift; cmd_status "$@" ;;
  attach)    shift; cmd_attach "$@" ;;
  list)
    shift
    # shellcheck source=lib/manage.sh
    . "$WTC_HOME/lib/manage.sh" || die "cannot load $WTC_HOME/lib/manage.sh"
    cmd_list "$@"
    ;;
  drop)
    shift
    # shellcheck source=lib/manage.sh
    . "$WTC_HOME/lib/manage.sh" || die "cannot load $WTC_HOME/lib/manage.sh"
    cmd_drop "$@"
    ;;
  *)         [ $# -ge 2 ] || { usage; exit 2; }; cmd_start "$@" ;;
esac
